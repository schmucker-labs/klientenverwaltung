# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# uv
.venv/
uv-cache/

# PyInstaller
build/
dist/
*.spec
# ...except the hand-maintained full-app specs (bundle ui/icons, ui/assets
# and alembic/) - a plain `pyinstaller main.py` would otherwise regenerate
# an unconfigured one and silently drop those data folders from the build.
!/klientenverwaltung.spec
!/klientenverwaltung-debug.spec

# SQLite / SQLCipher data files (nie unverschluesselt oder Testdaten committen)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Local screenshots of the running app (may show client data) - never commit
.testscreenshots/
